/tracking/verbose 0
/event/verbose 0

/tracking/storeTrajectory 0
#/tracking/discardParticleTrajectory opticalphoton

/process/had/particle_hp/use_photo_evaporation true
/process/had/particle_hp/do_not_adjust_final_state true

/rat/db/set DETECTOR experiment "ANNIE"
/rat/db/set DETECTOR geo_file "ANNIE/SANDI_run2_config14_scan.geo"
/rat/db/load ANNIE/ANNIE_AmBesource_v2.geo
# AmBe source 2.0 at port 2, Z = 0 mm: both top-level volumes have their origin at the
# AmBe pellet, so they get the same position = pellet position.
/rat/db/set GEO[AmBe_housing_body] position [47.7,0.0,475.4]

/rat/db/load ANNIE/SANDI2_WbLS_Vessel.geo


/rat/nCapPhysics/setnCaptureModel ANNRI

/run/initialize
#/rat/physics/scintillation/meanPhotonsPerSecondary 1
/rat/proc splitevdaq
/rat/proclast outanniecluster
#/rat/proclast outntuple
/rat/procset file "SANDI2_P5_yP050_test.ntuple.root"

#/generator/add combo spectrum:point
#/generator/vtx/set neutron ambe_neutron_spectrum
#/generator/pos/set 0.0 0.0 500.0

/generator/add combo spectrum:regexfill
/generator/vtx/set neutron AmBe_neutron_with_gamma
/generator/pos/set ^AmBeSource$

/run/beamOn 1000