/tracking/verbose 0
/event/verbose 0

/tracking/storeTrajectory 1
/tracking/discardParticleTrajectory opticalphoton

/process/had/particle_hp/use_photo_evaporation true
/process/had/particle_hp/do_not_adjust_final_state true

/rat/db/set DETECTOR experiment "ANNIE"
/rat/db/set DETECTOR geo_file "ANNIE/ANNIE_run2_scan.geo"
/rat/db/load ANNIE/ANNIE_AmBesource_v2.geo
# AmBe source 2.0 at port 2, Z = 0 mm: both top-level volumes have their origin at the
# AmBe pellet, so they get the same position = pellet position.
/rat/db/set GEO[AmBe_housing_body] position [0.0,0.0,0.0]

/annie/physics/annriGd true  
/annie/physics/annriGdCascade full

#/annie/physics/hpCaptureIsotopeFix true|false          # unchanged, default true
#/annie/physics/annriGd true|false                      # default true; false = previous behaviour (DICEBOX)
#/annie/physics/annriGdCascade full|discrete|continuum  # default full

/run/initialize
#/rat/physics/scintillation/meanPhotonsPerSecondary 1
/rat/proc splitevdaq
/rat/proclast outanniecluster
#/rat/proclast outntuple
/rat/procset file "ANNIE_neutrons_IsotopeFixDICEBOX_1.root"

#/generator/add combo gun:point
#/generator/vtx/set neutron 0.0 0.0 0.0 1.0
#/generator/pos/set 0.0 0.0 0.0

#/generator/add combo spectrum:point
#/generator/vtx/set neutron ambe_neutron_spectrum
#/generator/pos/set 0.0 750.0 -42.30

/generator/add combo spectrum:regexfill
/generator/vtx/set neutron AmBe_neutron_with_gamma
/generator/pos/set ^AmBeSource$

/run/beamOn 5000