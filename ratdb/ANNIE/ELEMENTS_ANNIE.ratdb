// Hydrogen bound in water: same as RAT's Hydrogen, but Geant4 recognises this name and uses the
// thermal scattering law S(alpha,beta) of H in H2O below 4 eV (G4NDL ThermalScattering h_water)
// instead of the free-gas model. Used by MATERIAL[water] in MATERIALS_ANNIE.ratdb.
{
name: "ELEMENT",
index: "TS_H_of_Water",
run_range: [0, 0],

SYMBOL: "H",
z: 1,
a: 1.008,
}

